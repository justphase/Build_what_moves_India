# Optional. Leave blank for the recommended single-service deployment.
# Use only when a separately hosted frontend is permitted to call this API.
CORS_ORIGINS=https://your-frontend.example.com

# Platform-provided port. Most hosts set this automatically.
PORT=8000

# Gnani AI Voice Integration (Vachana Platform - https://api.vachana.ai)
# Powers Speech-to-Text (Gnani Prisma v3.0 / v2.5) and Text-to-Speech (Gnani Timbre v2.5 / v3.0)
# Passed securely from backend via X-API-Key-ID header. Never exposed to the frontend.
GNANI_API_KEY=your_gnani_vachana_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini

# OpenAI Integration (Optional)
# If provided, OpenAI powers Hinglish intent understanding, conversational profile extraction, and scheme explanations.
# If omitted or invalid, deterministic NLU and rule fallbacks are used automatically.
# Note: Deterministic rule evaluation remains the sole source of truth for scheme eligibility.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
